<Window x:Class="Eco_Matic.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management" Height="420" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown"
        Loaded="Window_Loaded">
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#10000000" BlurRadius="15" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Register Staff" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Username:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <TextBox x:Name="txtUsername" Height="35" Padding="5,8" BorderBrush="#CBD5E1" Margin="0,0,0,10"/>

                <TextBlock x:Name="lblPassword" Text="Password:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <PasswordBox x:Name="txtPassword" Height="35" Padding="5,8" BorderBrush="#CBD5E1" Margin="0,0,0,10"/>

                <TextBlock Text="Role:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <Border Height="35" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Margin="0,0,0,10" Padding="8,0">
                    <TextBlock Text="Inventory Manager" VerticalAlignment="Center" Foreground="#1E293B" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="txtLoadStatus" Text="Loading roles and machines..." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10"/>

                <TextBlock x:Name="lblMachine" Text="Assigned Vending Machines:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <ListBox x:Name="lstMachines" Height="112" BorderBrush="#CBD5E1" SelectionMode="Multiple" DisplayMemberPath="location_name" SelectedValuePath="machine_id"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnConfirm" Grid.Column="0" Content="Register" Background="#2E77E6" Foreground="White" FontWeight="Bold" Height="40" Click="BtnConfirm_Click"/>
                <Button Grid.Column="2" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" FontWeight="Bold" Height="40" Click="BtnCancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
