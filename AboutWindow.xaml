<Window x:Class="Eco_Matic.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="329"
        Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0,16,-1"
              Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="README"
                        Style="{StaticResource TopActionTab}"
                        Click="BtnOpenReadme_Click" />
                <Button Content="ABOUT ME"
                        Style="{StaticResource TopActionTabActive}"
                        Margin="0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="-"
                        Style="{StaticResource WindowControlTab}"
                        Click="BtnMinimize_Click" />
                <Button Content="o"
                        Style="{StaticResource WindowControlTab}"
                        Click="BtnMaximize_Click" />
                <Button Content="x"
                        Style="{StaticResource WindowCloseTab}"
                        Margin="6,0,0,0"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#C5D3EB"
                BorderThickness="1"
                CornerRadius="16"
                MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#2F0C264A" BlurRadius="28" ShadowDepth="8" />
            </Border.Effect>

            <Border CornerRadius="15" ClipToBounds="True">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FBFF"
                            BorderBrush="#D7E2F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="12,0,0,0">
                                <TextBlock Text="Eco-Matic"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#1F2A44" TextAlignment="Center" 
                                           />
                                <TextBlock Text="Smart vending and recycling rewards station"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"
                                           FontSize="14"
                                           Foreground="#6A7891" />
                                <TextBlock Text="Version 1.0"
                                           TextAlignment="Center"
                                           Margin="0,18,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#2E77E6" />
                                <TextBlock Text="Copyright 2026 Seanix"
                                           TextAlignment="Center"
                                           Margin="0,18,0,0"
                                           FontSize="13"
                                           Foreground="#7A889F" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Row="1"
                            Width="120"
                            Height="36"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Content="Close"
                            Background="#2E77E6"
                            Foreground="White"
                            BorderBrush="#2E77E6"
                            BorderThickness="0"
                            Click="BtnClose_Click" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
