<Window x:Class="Eco_Matic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic"
        Height="620"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ControlTemplate x:Key="AnimatedButtonTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Grid>
                    <Border x:Name="hoverOverlay" Background="White" Opacity="0" CornerRadius="8" />
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.05" />
                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.05" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#2E77E6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2E77E6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template" Value="{StaticResource AnimatedButtonTemplate}" />
        </Style>

        <Style x:Key="CustomerActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#2FA66A" />
            <Setter Property="BorderBrush" Value="#2FA66A" />
        </Style>

        <Style x:Key="ExitActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#D65A5A" />
            <Setter Property="BorderBrush" Value="#D65A5A" />
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <ThicknessAnimation Storyboard.TargetName="TitleContainer" 
                                        Storyboard.TargetProperty="Margin" 
                                        From="-40,0,40,0" To="0,0,20,0" 
                                        Duration="0:0:0.7">
                        <ThicknessAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                    <DoubleAnimation Storyboard.TargetName="TitleContainer" 
                                     Storyboard.TargetProperty="Opacity" 
                                     From="0" To="1" 
                                     Duration="0:0:0.7" />

                    <ThicknessAnimation Storyboard.TargetName="MenuContainer" 
                                        Storyboard.TargetProperty="Margin" 
                                        From="40,0,-40,0" To="0,0,0,0" 
                                        Duration="0:0:0.7" BeginTime="0:0:0.15">
                        <ThicknessAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                    <DoubleAnimation Storyboard.TargetName="MenuContainer" 
                                     Storyboard.TargetProperty="Opacity" 
                                     From="0" To="1" 
                                     Duration="0:0:0.7" BeginTime="0:0:0.15" />

                    <DoubleAnimation Storyboard.TargetName="LeafLogoTransform" 
                                     Storyboard.TargetProperty="Angle" 
                                     From="-12" To="12" 
                                     Duration="0:0:4" 
                                     RepeatBehavior="Forever"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0,16,-1"
              Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="README"
                        Style="{StaticResource TopActionTabActive}"
                        Click="OpenReadmeMenuItem_Click" />
                <Button Content="ABOUT ME"
                        Style="{StaticResource TopActionTab}"
                        Margin="0"
                        Click="AboutMenuItem_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnMinimizeWindow"
                        Content="-"
                        Style="{StaticResource WindowControlTab}"
                        Click="BtnMinimizeWindow_Click" />
                <Button x:Name="btnMaxRestoreWindow"
                        Content="o"
                        Style="{StaticResource WindowControlTab}"
                        Click="BtnMaxRestoreWindow_Click" />
                <Button x:Name="btnCloseWindow"
                        Content="x"
                        Style="{StaticResource WindowCloseTab}"
                        Margin="6,0,0,0"
                        Click="BtnCloseWindow_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#C5D3EB"
                BorderThickness="1"
                CornerRadius="16"
                MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#2F0C264A" BlurRadius="45" ShadowDepth="12" />
            </Border.Effect>

            <Border CornerRadius="15" ClipToBounds="True">
                <Grid>
                    <!-- Background Design inside Card -->
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F8FBFF" Offset="0.8" />
                            <GradientStop Color="#EDF4FF" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <Ellipse Width="340" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-120,0,0" Fill="#F2F7FF" Opacity="0.5" />
                    <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Fill="#F0FAFC" Opacity="0.6" />

                    <Grid Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Side: Title -->
                        <StackPanel x:Name="TitleContainer" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0">
                            
                            <Grid Margin="0,0,0,24" Width="95" Height="95" RenderTransformOrigin="0.5,0.9">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="LeafLogoTransform" Angle="0"/>
                                </Grid.RenderTransform>

                                <!-- Stem -->
                                <Path Stroke="#181D1A" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" 
                                      Data="M 50 95 C 48 70 52 45 65 25" x:Name="StemPath">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="StemTrans"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Bottom Leaf -->
                                <Path Stroke="#181D1A" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Data="M 50 82 C 35 88 20 75 25 62 C 30 50 45 65 50 75" x:Name="Leaf1">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Leaf1Trans"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Middle Leaf -->
                                <Path Stroke="#181D1A" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Data="M 50 68 C 68 74 85 62 80 48 C 75 35 60 48 53 58" x:Name="Leaf2">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Leaf2Trans"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Upper Leaf -->
                                <Path Stroke="#181D1A" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Data="M 55 52 C 40 50 32 30 42 18 C 50 8 62 20 58 35" x:Name="Leaf3">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Leaf3Trans"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Top Leaf -->
                                <Path Stroke="#181D1A" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Data="M 64 36 C 85 34 95 10 85 0 C 75 -10 58 4 62 25" x:Name="Leaf4">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Leaf4Trans"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Invisible Overlay for Hover Detection -->
                                <Rectangle Fill="#01000000" x:Name="HoverZone">
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <!-- Leaf 4 (Top) falls first -->
                                                    <DoubleAnimation Storyboard.TargetName="Leaf4Trans" Storyboard.TargetProperty="Y" To="120" Duration="0:0:1.2" BeginTime="0:0:0">
                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf4" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2" BeginTime="0:0:0"/>
                                                    
                                                    <!-- Leaf 3 falls -->
                                                    <DoubleAnimation Storyboard.TargetName="Leaf3Trans" Storyboard.TargetProperty="Y" To="120" Duration="0:0:1.2" BeginTime="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf3" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2" BeginTime="0:0:0.3"/>
                                                    
                                                    <!-- Leaf 2 falls -->
                                                    <DoubleAnimation Storyboard.TargetName="Leaf2Trans" Storyboard.TargetProperty="Y" To="120" Duration="0:0:1.2" BeginTime="0:0:0.6">
                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2" BeginTime="0:0:0.6"/>
                                                    
                                                    <!-- Leaf 1 falls -->
                                                    <DoubleAnimation Storyboard.TargetName="Leaf1Trans" Storyboard.TargetProperty="Y" To="120" Duration="0:0:1.2" BeginTime="0:0:0.9">
                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2" BeginTime="0:0:0.9"/>

                                                    <!-- Stem falls last -->
                                                    <DoubleAnimation Storyboard.TargetName="StemTrans" Storyboard.TargetProperty="Y" To="120" Duration="0:0:1.2" BeginTime="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="StemPath" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.2" BeginTime="0:0:1.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <!-- Instant respawn at original position -->
                                                    <DoubleAnimation Storyboard.TargetName="Leaf4Trans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0"/>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf4" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                                                    
                                                    <DoubleAnimation Storyboard.TargetName="Leaf3Trans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0"/>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf3" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                                                    
                                                    <DoubleAnimation Storyboard.TargetName="Leaf2Trans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0"/>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf2" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                                                    
                                                    <DoubleAnimation Storyboard.TargetName="Leaf1Trans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0"/>
                                                    <DoubleAnimation Storyboard.TargetName="Leaf1" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>

                                                    <DoubleAnimation Storyboard.TargetName="StemTrans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0"/>
                                                    <DoubleAnimation Storyboard.TargetName="StemPath" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </Grid>

                            <TextBlock Text="Eco Matic"
                                       FontFamily="Georgia"
                                       FontSize="56"
                                       FontStyle="Italic"
                                       FontWeight="Bold"
                                       Foreground="#1E821F"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="VENDING MACHINE"
                                       FontFamily="Segoe UI"
                                       FontSize="17"
                                       Foreground="#6C7E93"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,40" />

                            <TextBlock Text="Fresh • Fast • Eco-Friendly"
                                       FontStyle="Italic"
                                       FontSize="16"
                                       Foreground="#71A086"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Right Side: Menu Buttons -->
                        <Border x:Name="MenuContainer" Grid.Row="0" Grid.Column="1" 
                                Background="#FFFFFF" 
                                BorderBrush="#E1EAF7" 
                                BorderThickness="1" 
                                CornerRadius="20" 
                                Padding="28" 
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#15002040" BlurRadius="24" ShadowDepth="4" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Get Started"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#1F3960"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Select your operating mode."
                                           Foreground="#6D84A3"
                                           FontSize="15"
                                           Margin="0,0,0,26" />

                                <Button x:Name="btnCustomer"
                                        Margin="0,0,0,16"
                                        Content="Customer Mode"
                                        Style="{StaticResource CustomerActionButton}"
                                        Click="BtnCustomer_Click" />

                                <Button x:Name="btnAdmin"
                                        Margin="0,0,0,16"
                                        Content="Admin Console"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Click="BtnAdmin_Click" />

                                <Separator Background="#E1EAF7" Margin="0,10,0,26" />

                                <Button x:Name="btnExit"
                                        Content="Exit Station"
                                        Style="{StaticResource ExitActionButton}"
                                        Height="48"
                                        Background="#FFF4F4"
                                        BorderBrush="#F2D8D8"
                                        BorderThickness="1"
                                        Foreground="#D65A5A"
                                        Click="BtnExit_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,24,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#A3B4CC"
                                   Text="Copyright 2026 Seanix" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
