# Supabase
ECOMATIC_SUPABASE_URL=https://your-project-ref.supabase.co
ECOMATIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Local MySQL offline cache
ECOMATIC_LOCAL_MYSQL_HOST=localhost
ECOMATIC_LOCAL_MYSQL_PORT=3306
ECOMATIC_LOCAL_MYSQL_USER=root
ECOMATIC_LOCAL_MYSQL_PASSWORD=your_mysql_password_here
ECOMATIC_LOCAL_MYSQL_SCHEMA=eco_matic_latest

# ESP32-S3 hardware bridge
ECOMATIC_ARDUINO_PORT=COM5
ECOMATIC_ARDUINO_BAUD=9600

# POS58 Bluetooth receipt printer
# Set the paired Windows Bluetooth serial port for your printer, for example COM6 or COM7.
ECOMATIC_RECEIPT_PRINTER_ENABLED=true
ECOMATIC_RECEIPT_PRINTER_MODE=Windows
ECOMATIC_RECEIPT_PRINTER_NAME=POS-58 Bluetooth
ECOMATIC_RECEIPT_PRINTER_PORT=COM6
ECOMATIC_RECEIPT_PRINTER_BAUD_RATE=9600
ECOMATIC_RECEIPT_PRINTER_DATA_BITS=8
ECOMATIC_RECEIPT_PRINTER_STOP_BITS=One
ECOMATIC_RECEIPT_PRINTER_PARITY=None
ECOMATIC_RECEIPT_PRINTER_DTR_ENABLE=true
ECOMATIC_RECEIPT_PRINTER_RTS_ENABLE=true

# Printed receipt identity
ECOMATIC_RECEIPT_COMPANY_NAME=Leaf Solutions
ECOMATIC_RECEIPT_BRAND_NAME=Eco-Matic
ECOMATIC_RECEIPT_ADDRESS=123 Greenway Ave, Quezon City
ECOMATIC_RECEIPT_PHONE=(02) 8555-0100
ECOMATIC_RECEIPT_SLOGAN=Smart Vending, Greener Living
ECOMATIC_RECEIPT_BUSINESS_LINE1=NON-VAT REG TIN 555-010-555-000
ECOMATIC_RECEIPT_BUSINESS_LINE2=PERMIT NO. PTU-2026-000555
