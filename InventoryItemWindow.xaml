<Window x:Class="Eco_Matic.InventoryItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Machine Slot" Height="850" Width="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown"
        Loaded="Window_Loaded">
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#10000000" BlurRadius="15" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleContent" Text="Assign Item to Machine Slot" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">

                <TextBlock Text="Slot ID (1-12):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <TextBox x:Name="txtSlotId" Height="35" Padding="5,8" Margin="0,0,0,15" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Global Item:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <ComboBox x:Name="cboExistingItem" Padding="10,8" Margin="0,0,0,6" BorderBrush="#CBD5E1" Height="35"
                          DisplayMemberPath="name" SelectionChanged="CboExistingItem_SelectionChanged"/>
                <TextBlock x:Name="txtCatalogStatus" Text="Loading global items..." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,15"/>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Global Item Preview" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox x:Name="txtName" Height="35" Padding="5,8" Margin="0,4,0,10" BorderBrush="#CBD5E1" IsReadOnly="True"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Type" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBox x:Name="txtType" Height="35" Padding="5,8" Margin="0,4,0,0" BorderBrush="#CBD5E1" IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default Price (₱)" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBox x:Name="txtDefaultPrice" Height="35" Padding="5,8" Margin="0,4,0,0" BorderBrush="#CBD5E1" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Image Reference" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox x:Name="txtImagePath" Height="35" Padding="5,8" Margin="0,4,0,10" BorderBrush="#CBD5E1" IsReadOnly="True"/>

                        <TextBlock Text="Dispense Message" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox x:Name="txtDispenseMessage" Height="55" Padding="5,8" Margin="0,4,0,10" BorderBrush="#CBD5E1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>

                        <TextBlock Text="Examine Message" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox x:Name="txtExamineMessage" Height="70" Padding="5,8" Margin="0,4,0,0" BorderBrush="#CBD5E1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Machine Price Override (₱)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                        <TextBox x:Name="txtSlotPrice" Height="35" Padding="5,8" BorderBrush="#CBD5E1"/>
                        <TextBlock Text="Leave blank to use the global default price." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stock" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                        <TextBox x:Name="txtStock" Height="35" Padding="5,8" BorderBrush="#CBD5E1" Text="15"/>
                        <TextBlock Text="Enter a value from 0 to 15." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnSave" Grid.Column="0" Content="Save Slot" Background="#2E77E6" Foreground="White" FontWeight="Bold" Height="40" Click="BtnSave_Click"/>
                <Button Grid.Column="2" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" FontWeight="Bold" Height="40" Click="BtnCancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
