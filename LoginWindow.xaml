<Window x:Class="Eco_Matic.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic Login"
        Height="420"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,0,16,-1" Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCloseWindow"
                        Content="x"
                        Style="{StaticResource WindowCloseTab}"
                        Margin="6,0,0,0"
                        Click="BtnCloseWindow_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#C5D3EB"
                BorderThickness="1"
                CornerRadius="16"
                MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#2F0C264A" BlurRadius="45" ShadowDepth="12" />
            </Border.Effect>

            <Border CornerRadius="15" ClipToBounds="True">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Login"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2E77E6"
                               Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1"
                               Margin="0,0,0,24"
                               Foreground="#6A7891"
                               Text="Enter your credentials to access your account." />

                    <TextBlock Grid.Row="2" Text="Email/Username" Foreground="#6A7891" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="txtUsername"
                             Grid.Row="3"
                             Height="40"
                             Margin="0,0,0,15"
                             Padding="10,0,10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             KeyDown="TxtControl_KeyDown" />

                    <TextBlock Grid.Row="4" Text="Password" Foreground="#6A7891" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <PasswordBox x:Name="txtPassword"
                                 Grid.Row="5"
                                 Height="40"
                                 Margin="0,0,0,30"
                                 Padding="10,0,10,0"
                                 VerticalContentAlignment="Center"
                                 PasswordChar="*"
                                 KeyDown="TxtControl_KeyDown" />

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="Cancel"
                                Width="100"
                                Height="38"
                                Margin="0,0,10,0"
                                Click="BtnCancel_Click" />
                        <Button Content="Login"
                                Width="100"
                                Height="38"
                                Background="#2E77E6"
                                Foreground="White"
                                BorderBrush="#2E77E6"
                                BorderThickness="0"
                                Click="BtnLogin_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
