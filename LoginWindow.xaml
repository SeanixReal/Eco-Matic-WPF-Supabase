<Window x:Class="Eco_Matic.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Login"
        Height="290"
        Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid Margin="14">
        <Border Background="#F2F5FB"
                BorderBrush="#D7DFEC"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14">
            <Border.Effect>
                <DropShadowEffect Color="#18000000" BlurRadius="20" ShadowDepth="8" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#D7DFEC"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Admin Login"
                                   FontWeight="SemiBold"
                                   Foreground="#2E77E6"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Width="30"
                                Height="24"
                                Padding="0"
                                Content="x"
                                Foreground="#C45D5D"
                                Background="#FFF1F1"
                                BorderBrush="#F1D5D5"
                                BorderThickness="1"
                                Click="BtnCloseWindow_Click" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="Admin Access"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2E77E6"
                           Margin="0,0,0,4" />
                <TextBlock Grid.Row="1"
                           Margin="0,34,0,0"
                           Foreground="#6A7891"
                           Text="Enter your password to continue." />

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="2"
                             Margin="0,18,0,0"
                             Height="36"
                             VerticalContentAlignment="Center"
                             PasswordChar="*"
                             KeyDown="TxtPassword_KeyDown" />

                <TextBlock Grid.Row="3"
                           Margin="0,12,0,0"
                           Foreground="#7E8DA8"
                           Text="Default password: admin123" />

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Cancel"
                            Width="94"
                            Margin="0,0,8,0"
                            Click="BtnCancel_Click" />
                    <Button Content="Login"
                            Width="94"
                            Background="#2E77E6"
                            Foreground="White"
                            BorderBrush="#2E77E6"
                            BorderThickness="0"
                            Click="BtnLogin_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
