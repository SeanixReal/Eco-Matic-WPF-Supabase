<Window x:Class="Eco_Matic.MachineSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Vending Machine"
        Height="500"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="MachineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="136" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="#C5D3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0,16,-1"
              Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="README"
                        Style="{StaticResource TopActionTabActive}"
                        Click="OpenReadmeMenuItem_Click" />
                <Button Content="ABOUT ME"
                        Style="{StaticResource TopActionTab}"
                        Margin="0"
                        Click="AboutMenuItem_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCloseWindow"
                        Content="x"
                        Style="{StaticResource WindowCloseTab}"
                        Margin="6,0,0,0"
                        Click="BtnCloseWindow_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#C5D3EB"
                BorderThickness="1"
                CornerRadius="18"
                MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#2F0C264A" BlurRadius="25" ShadowDepth="6" />
            </Border.Effect>

            <Border CornerRadius="17" ClipToBounds="True">
                <Grid Margin="30,26,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Select a Kiosk"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2E77E6"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1"
                               x:Name="txtStatus"
                               Text="Please pick a machine location to interact with."
                               Foreground="#6A7891"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ItemsControl x:Name="icMachines" Grid.Row="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding MachineId}"
                                        Style="{StaticResource MachineButtonStyle}"
                                        Click="BtnMachine_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MachineName}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#2E77E6"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Address}"
                                                   Margin="0,6,0,0"
                                                   Foreground="#52637F"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="48" />
                                        <Border Margin="0,10,0,0"
                                                Background="#EAF2FF"
                                                BorderBrush="#CFE0FF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="Tap to select"
                                                       Margin="8,4"
                                                       Foreground="#2E77E6"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
