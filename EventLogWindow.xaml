<Window x:Class="Eco_Matic.EventLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Log"
        Height="520"
        Width="860"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid>
        <!-- Custom Window Controls Tab -->
        
        <!-- Main Card Border -->
        <Border Background="Transparent" CornerRadius="12" Margin="0,30,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.1" />
            </Border.Effect>
            <Grid Margin="14">
                    <Border Background="White"
                            BorderBrush="#D7DFEC"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#10000000" BlurRadius="18" ShadowDepth="4" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Event Log"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#2E77E6"
                                       Margin="0,0,0,10" />

                            <TextBox x:Name="txtLog"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     Background="#F9FBFF"
                                     Foreground="#20304C"
                                     BorderBrush="#D7DFEC"
                                     BorderThickness="1"
                                     Padding="10" />

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0">
                                <Button Content="Refresh"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Background="#2E77E6"
                                        Foreground="White"
                                        BorderBrush="#2E77E6"
                                        BorderThickness="0"
                                        Click="BtnRefresh_Click" />
                                <Button Content="Close"
                                        Width="100"
                                        Click="BtnClose_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
        </Border>
    </Grid>
</Window>