<Window x:Class="Eco_Matic.EditMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Machine" Height="560" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#10000000" BlurRadius="15" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Edit Vending Machine" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Machine Name:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <TextBox x:Name="txtLocationName" Height="35" Padding="5,8" BorderBrush="#CBD5E1" Margin="0,0,0,15"/>

                <TextBlock Text="Address / Location:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <TextBox x:Name="txtAddress" MinHeight="86" Padding="8" BorderBrush="#CBD5E1" Margin="0,0,0,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="Pick on Map" Width="120" Height="34" Background="#2E77E6" Foreground="White" BorderBrush="#2E77E6" Click="BtnPickOnMap_Click"/>
                    <TextBlock x:Name="txtCoordinates"
                               Margin="12,7,0,0"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               Text="Coordinates not set"/>
                </StackPanel>

                <TextBlock Text="Status:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                <ComboBox x:Name="cboStatus" Height="35" Padding="5,8" BorderBrush="#CBD5E1" Margin="0,0,0,15">
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="Maintenance"/>
                    <ComboBoxItem Content="Offline"/>
                </ComboBox>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Save Config" Background="#2E77E6" Foreground="White" FontWeight="Bold" Height="40" Click="BtnConfirm_Click"/>
                <Button Grid.Column="2" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" FontWeight="Bold" Height="40" Click="BtnCancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
