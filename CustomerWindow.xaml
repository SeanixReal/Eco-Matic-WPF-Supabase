<Window x:Class="Eco_Matic.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic - Customer"
        Height="880"
        Width="1050"
        MinHeight="800"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Foreground="#1F2A44"
        FontFamily="Bahnschrift"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <LinearGradientBrush x:Key="CabinetBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F9FBFE" Offset="0" />
            <GradientStop Color="#EEF3FA" Offset="0.48" />
            <GradientStop Color="#E5ECF6" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="SlotCellStyle" TargetType="Border">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2EBF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlotImageWellStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style TargetType="Image">
            <Setter Property="MaxHeight" Value="140" />
            <Setter Property="MaxWidth" Value="160" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SlotNameStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#22324D" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SlotPriceStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E77E6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="SlotButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Background" Value="#2FA66A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#38C17B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#258A57" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MoneyButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="#FFCE4A" />
            <Setter Property="Foreground" Value="#1D233F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MoneyBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MoneyBorder" Property="Background" Value="#FFD862" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MoneyBorder" Property="Background" Value="#E7B936" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0,16,-1"
              Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="README"
                        Style="{StaticResource TopActionTabActive}"
                        Click="OpenReadmeMenuItem_Click" />
                <Button Content="ABOUT ME"
                        Style="{StaticResource TopActionTab}"
                        Margin="0"
                        Click="AboutMenuItem_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnMinimizeWindow"
                        Content="-"
                        Style="{StaticResource WindowControlTab}"
                        Click="BtnMinimize_Click" />
                <Button x:Name="btnMaxRestoreWindow"
                        Content="o"
                        Style="{StaticResource WindowControlTab}"
                        Click="BtnMaximize_Click" />
                <Button x:Name="btnCloseWindow"
                        Content="x"
                        Style="{StaticResource WindowCloseTab}"
                        Margin="6,0,0,0"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- Main Card Border -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#C5D3EB"
                BorderThickness="1"
                CornerRadius="16"
                MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#2F0C264A" BlurRadius="45" ShadowDepth="12" />
            </Border.Effect>

            <Border CornerRadius="15" ClipToBounds="True">
                <Grid x:Name="RootScene" Margin="12">

                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F2F6FC" Offset="0" />
                            <GradientStop Color="#EBF1FA" Offset="0.52" />
                            <GradientStop Color="#E5ECF7" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="160" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="10"
                            CornerRadius="18"
                            BorderBrush="#B8C8DF"
                            BorderThickness="2"
                            Background="{StaticResource CabinetBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#18000000" BlurRadius="22" ShadowDepth="6" Opacity="0.5" />
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="10"
                                    Margin="0,0,0,8"
                                    CornerRadius="8"
                                    BorderBrush="#C5D5EC"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#F1F6FD" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ECO-MATIC"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#2E77E6"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Eco Vending Machine"
                                               Margin="0,1,0,0"
                                               Foreground="#6A7891"
                                               FontSize="11"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="7"
                                    CornerRadius="10"
                                    BorderBrush="#C5D5EC"
                                    BorderThickness="2"
                                    Background="#F2F6FC">
                                <Grid>
                                    <UniformGrid Rows="3" Columns="4" MinHeight="350">
                                        <Border x:Name="pnlSlot1" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot1" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName1" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice1" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel1" Grid.Row="2" Content="SELECT" Tag="1" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot2" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot2" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName2" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice2" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel2" Grid.Row="2" Content="SELECT" Tag="2" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot3" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot3" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName3" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice3" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel3" Grid.Row="2" Content="SELECT" Tag="3" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot4" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot4" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName4" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice4" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel4" Grid.Row="2" Content="SELECT" Tag="4" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot5" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot5" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName5" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice5" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel5" Grid.Row="2" Content="SELECT" Tag="5" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot6" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot6" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName6" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice6" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel6" Grid.Row="2" Content="SELECT" Tag="6" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot7" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot7" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName7" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice7" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel7" Grid.Row="2" Content="SELECT" Tag="7" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot8" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot8" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName8" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice8" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel8" Grid.Row="2" Content="SELECT" Tag="8" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot9" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot9" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName9" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice9" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel9" Grid.Row="2" Content="SELECT" Tag="9" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot10" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot10" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName10" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice10" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel10" Grid.Row="2" Content="SELECT" Tag="10" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot11" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot11" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName11" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice11" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel11" Grid.Row="2" Content="SELECT" Tag="11" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="pnlSlot12" Style="{StaticResource SlotCellStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource SlotImageWellStyle}">
                                                    <Image x:Name="imgSlot12" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock x:Name="lblName12" Text="EMPTY" Style="{StaticResource SlotNameStyle}" />
                                                    <TextBlock x:Name="lblPrice12" Style="{StaticResource SlotPriceStyle}" />
                                                </StackPanel>
                                                <Button x:Name="btnSel12" Grid.Row="2" Content="SELECT" Tag="12" Style="{StaticResource SlotButtonStyle}" Click="SelectButton_Click" />
                                            </Grid>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                            </Grid>

                            <!-- RIGHT SIDE: Control Panel -->
                            <Border Grid.Column="1"
                                    CornerRadius="8"
                                    BorderBrush="#C7D5E9"
                                    BorderThickness="1"
                                    Padding="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#F4F8FD" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Inserted Money -->
                                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="INSERTED" Foreground="#6A7891" FontSize="12" />
                                            <Viewbox Height="55" HorizontalAlignment="Right" StretchDirection="DownOnly" Margin="0,4,0,0">
                                                <TextBlock x:Name="lblMoneyAmount"
                                                           Text="P 0.00"
                                                           FontFamily="Consolas"
                                                           FontSize="48"
                                                           FontWeight="Bold"
                                                           Foreground="#2FA66A" />
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Insert Bills -->
                                    <Border Grid.Row="1" Background="#F5FAFF" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="INSERT BILLS" FontWeight="Bold" Foreground="#B98900" />
                                            <WrapPanel Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Center">
                                                <Button Tag="20" Content="P20" Style="{StaticResource MoneyButtonStyle}" Click="BtnMoney_Click" Margin="0,0,4,4" />
                                                <Button Tag="50" Content="P50" Style="{StaticResource MoneyButtonStyle}" Click="BtnMoney_Click" Margin="0,0,4,4" />
                                                <Button Tag="100" Content="P100" Style="{StaticResource MoneyButtonStyle}" Click="BtnMoney_Click" Margin="0,0,4,4" />
                                                <Button Tag="200" Content="P200" Style="{StaticResource MoneyButtonStyle}" Click="BtnMoney_Click" Margin="0,0,4,4" />
                                                <Button Tag="500" Content="P500" Style="{StaticResource MoneyButtonStyle}" Click="BtnMoney_Click" Margin="0,0,4,4" />
                                                <Button Tag="1000" Content="P1000" Style="{StaticResource MoneyButtonStyle}" Click="BtnMoney_Click" Margin="0,0,4,4" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Recycle -->
                                    <Border Grid.Row="2" Background="#F5FAFF" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="RECYCLE FOR CREDIT" FontWeight="Bold" Foreground="#2F9C63" />
                                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                <ComboBox x:Name="cboRecycleType" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtRecycleQty" Grid.Column="0" Width="40" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                    <TextBlock x:Name="lblRecycleStatus" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#4C7A67" Text="Ready" />
                                                    <Button Grid.Column="2" Width="60" Content="ADD" Background="#2FA66A" Foreground="White" BorderBrush="#2FA66A" BorderThickness="0" Click="BtnRecycle_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Examine -->
                                    <Border Grid.Row="3" Background="#F5FAFF" BorderBrush="#D7E2F0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="EXAMINE ITEM" FontWeight="Bold" Foreground="#2E77E6" />
                                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                <ComboBox x:Name="cboExamineItem" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                                <Button Content="EXAMINE" HorizontalAlignment="Right" Width="80" Background="#2E77E6" Foreground="White" BorderBrush="#2E77E6" BorderThickness="0" Click="BtnExamine_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- LCD Display (Arduino/LCD Emulator) -->
                                    <Border Grid.Row="4" 
                                            Margin="0,0,0,10" 
                                            Background="#0A1208" 
                                            BorderBrush="#1A2B18" 
                                            BorderThickness="2" 
                                            CornerRadius="4" 
                                            Padding="12" 
                                            Height="110">
                                        <Grid>
                                            <TextBlock x:Name="lblLcdDisplay" 
                                                       Text="ECO-MATIC v1.1&#x0a;SYSTEM READY..." 
                                                       Foreground="#42FF42" 
                                                       FontFamily="Consolas" 
                                                       FontSize="15" 
                                                       TextWrapping="Wrap">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="5" Color="#33FF33" ShadowDepth="0" Opacity="0.7" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <!-- Scanlines -->
                                            <Rectangle Opacity="0.05" IsHitTestVisible="False">
                                                <Rectangle.Fill>
                                                    <VisualBrush TileMode="Tile" Viewport="0,0,1,3" ViewportUnits="Absolute">
                                                        <VisualBrush.Visual>
                                                            <Rectangle Width="1" Height="1" Fill="Black" />
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>

                                    <!-- Actions -->
                                    <Grid Grid.Row="6" VerticalAlignment="Bottom">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="HELP" Grid.Column="0" Margin="0,0,4,0" Click="BtnHelp_Click" Height="40" />
                                            <Button x:Name="btnBack" Grid.Column="1" Margin="4,0,0,0" Content="DONE" Background="#2E77E6" Foreground="White" BorderBrush="#2E77E6" BorderThickness="0" Click="BtnBack_Click" Height="40" />
                                        </Grid>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,15,0,0"
                            CornerRadius="12"
                            BorderBrush="#A0B4CF"
                            BorderThickness="4"
                            Padding="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#C5D3E5" Offset="0" />
                                <GradientStop Color="#DBE4F0" Offset="0.15" />
                                <GradientStop Color="#F1F5FA" Offset="0.5" />
                                <GradientStop Color="#E8EFF7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                             <Grid x:Name="pnlDispenseTray" ClipToBounds="True">
                                 <Image x:Name="imgDispense" 
                                        Stretch="Uniform" 
                                        Height="120" 
                                        Width="120"
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center" 
                                        RenderTransformOrigin="0.5,0.5">
                                     <Image.RenderTransform>
                                         <TransformGroup>
                                             <RotateTransform x:Name="imgDispenseRotate" Angle="0" />
                                             <TranslateTransform x:Name="imgDispenseTranslate" X="0" Y="0" />
                                         </TransformGroup>
                                     </Image.RenderTransform>
                                 </Image>
                             </Grid>
                         </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#7A889F"
                               Text="ECO-MATIC  Recycle and Reward" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>