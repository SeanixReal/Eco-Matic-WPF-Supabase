<Window x:Class="Eco_Matic.ItemDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item Details"
        Height="470"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0,16,-1"
              Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="README"
                        Style="{StaticResource TopActionTabActive}"
                        Click="OpenReadmeMenuItem_Click" />
                <Button Content="ABOUT ME"
                        Style="{StaticResource TopActionTab}"
                        Margin="0"
                        Click="AboutMenuItem_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="x"
                        Style="{StaticResource WindowCloseTab}"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#C5D3EB"
                BorderThickness="1"
                CornerRadius="18"
                MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#2F0C264A" BlurRadius="25" ShadowDepth="6" />
            </Border.Effect>

            <Border CornerRadius="17" ClipToBounds="True">
                <Grid Margin="26,24,26,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FBFF"
                            BorderBrush="#D7E2F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="White"
                                    BorderBrush="#D7E2F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,16,0">
                                <Image x:Name="imgItem"
                                       Stretch="Uniform"
                                       Height="120"
                                       Width="120"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="txtItemName"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#1F2A44"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="txtItemType"
                                           Margin="0,4,0,0"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="txtPriceSummary"
                                           Margin="0,14,0,0"
                                           Foreground="#2E77E6"
                                           FontSize="16"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="txtStockSummary"
                                           Margin="0,6,0,0"
                                           Foreground="#475569"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="txtSlotSummary"
                                           Margin="0,4,0,0"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            BorderBrush="#D7E2F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Description"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#2E77E6" />
                            <TextBlock x:Name="txtDescription"
                                       Margin="0,10,0,0"
                                       Foreground="#334155"
                                       FontSize="14"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="2"
                            Content="CLOSE"
                            Width="120"
                            Height="38"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0"
                            Background="#2E77E6"
                            Foreground="White"
                            BorderBrush="#2E77E6"
                            BorderThickness="0"
                            Click="BtnClose_Click" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
