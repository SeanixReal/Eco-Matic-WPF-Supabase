<Window x:Class="Eco_Matic.ReadmeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="README"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Border Background="White"
                BorderBrush="#D7DFEC"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="#10000000" BlurRadius="18" ShadowDepth="4" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="README"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2E77E6"
                           Margin="0,0,0,10" />

                <TextBox x:Name="txtContent"
                         Grid.Row="1"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#F9FBFF"
                         Foreground="#20304C"
                         BorderBrush="#D7DFEC"
                         BorderThickness="1"
                         Padding="10" />

                <Button Grid.Row="2"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Content="Close"
                        Background="#2E77E6"
                        Foreground="White"
                        BorderBrush="#2E77E6"
                        BorderThickness="0"
                        Click="BtnClose_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
