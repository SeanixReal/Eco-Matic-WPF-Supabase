<Window x:Class="Eco_Matic.QrPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic - QR Payment"
        Height="690"
        Width="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Bahnschrift"
        Background="Transparent"
        Foreground="#1F2A44"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0,16,-1"
              Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="QR PAYMENT"
                    Style="{StaticResource TopActionTabActive}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="-"
                        Style="{StaticResource WindowControlTab}"
                        Click="BtnMinimize_Click" />
                <Button Content="x"
                        Style="{StaticResource WindowCloseTab}"
                        Margin="6,0,0,0"
                        Click="BtnCancel_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#C5D3EB"
                BorderThickness="1"
                CornerRadius="16"
                MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#22000000" BlurRadius="32" ShadowDepth="10" />
            </Border.Effect>

            <Border Margin="12"
                    Padding="18"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#D7E2F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock Text="SCAN QR TO PAY"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#2E77E6"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="txtStatus"
                                   Text="Generating secure payment QR..."
                                   Margin="0,4,0,0"
                                   Foreground="#6A7891"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,16,0,12"
                            Padding="12"
                            Background="#F5FAFF"
                            BorderBrush="#D7E2F0"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PAYMENT AMOUNT"
                                       Foreground="#6A7891"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtAmount"
                                         Height="34"
                                         FontSize="18"
                                         FontWeight="Bold"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtAmount_TextChanged" />
                                <TextBlock Grid.Column="1"
                                           Text="PHP"
                                           Margin="10,8,10,0"
                                           FontWeight="Bold"
                                           Foreground="#2FA66A" />
                                <Button x:Name="btnUpdateQr"
                                        Grid.Column="2"
                                        Content="UPDATE QR"
                                        Height="34"
                                        MinWidth="96"
                                        Background="#2E77E6"
                                        Foreground="White"
                                        BorderBrush="#2E77E6"
                                        FontWeight="Bold"
                                        Click="BtnUpdateQr_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Width="336"
                            Height="336"
                            Padding="12"
                            Background="#FFFFFF"
                            BorderBrush="#C8D6EA"
                            BorderThickness="1"
                            CornerRadius="14"
                            HorizontalAlignment="Center"
                            ClipToBounds="False">
                        <Image x:Name="imgQrCode"
                               Width="312"
                               Height="312"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="txtReference"
                                   Foreground="#44546F"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Scan with your phone camera. Eco-Matic will update automatically."
                                   Margin="0,7,0,0"
                                   Foreground="#7A889F"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Row="4"
                            Content="CANCEL"
                            Height="38"
                            Margin="0,18,0,0"
                            Click="BtnCancel_Click" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
