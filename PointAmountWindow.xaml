<Window x:Class="Eco_Matic.PointAmountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic - Points"
        WindowStyle="None"
        Height="280"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Bahnschrift"
        AllowsTransparency="True"
        Background="Transparent"
        >
    <Border Margin="18"
            Padding="18"
            Background="White"
            BorderBrush="#D7E2F0"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle"
                       Text="Point Amount"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2E77E6" />

            <TextBlock x:Name="txtHelp"
                       Grid.Row="1"
                       Margin="0,8,0,14"
                       Text="Enter the point amount."
                       Foreground="#64748B"
                       TextWrapping="Wrap" />

            <TextBox x:Name="txtPoints"
                     Grid.Row="2"
                     Height="42"
                     Margin="0,0,0,0"
                     FontSize="22"
                     FontFamily="Consolas"
                     FontWeight="Bold"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     PreviewTextInput="TxtPoints_PreviewTextInput"
                     KeyDown="TxtPoints_KeyDown" />

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="CANCEL"
                        Height="40"
                        Margin="0,0,6,0"
                        Background="#F2F5FB"
                        Foreground="#1E293B"
                        BorderBrush="#CBD5E1"
                        FontWeight="Bold"
                        Click="BtnCancel_Click" />
                <Button Grid.Column="1"
                        Content="SAVE"
                        Height="40"
                        Margin="6,0,0,0"
                        Background="#2E77E6"
                        Foreground="White"
                        BorderBrush="#2E77E6"
                        FontWeight="Bold"
                        Click="BtnSave_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
