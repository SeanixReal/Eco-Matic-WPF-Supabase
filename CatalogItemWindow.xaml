<Window x:Class="Eco_Matic.CatalogItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalog Item" Height="780" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#10000000" BlurRadius="15" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleContent" Text="Add Catalog Item" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Item Name:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                    <TextBox x:Name="txtName" Height="35" Padding="5,8" Margin="0,0,0,15" BorderBrush="#CBD5E1"/>

                    <TextBlock Text="Item Type:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                    <ComboBox x:Name="cboType" Padding="10,8" Margin="0,0,0,15" BorderBrush="#CBD5E1" Height="35">
                        <ComboBoxItem Content="Snack" IsSelected="True"/>
                        <ComboBoxItem Content="Drink"/>
                        <ComboBoxItem Content="Misc"/>
                    </ComboBox>

                    <TextBlock Text="Image Reference:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtImagePath" Height="35" Padding="5,8" BorderBrush="#CBD5E1" IsReadOnly="True" Text="Assets/Images/placeholder.png"/>
                        <Button x:Name="btnBrowseImage" Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Padding="10,0" Height="35" Click="BtnBrowseImage_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default Price (₱):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                            <TextBox x:Name="txtPrice" Height="35" Padding="5,8" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Calories:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                            <TextBox x:Name="txtCalories" Height="35" Padding="5,8" BorderBrush="#CBD5E1" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Dispense Message:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                    <TextBox x:Name="txtDispenseMessage" Height="55" Padding="5,8" Margin="0,0,0,15" BorderBrush="#CBD5E1" Text="Enjoy your item!" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Text="Examine Message:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#64748B"/>
                    <TextBox x:Name="txtExamineMessage" Height="85" Padding="5,8" Margin="0,0,0,15" BorderBrush="#CBD5E1" Text="A standard vending item." TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Save Item" Background="#2E77E6" Foreground="White" FontWeight="Bold" Height="40" Click="BtnSave_Click"/>
                <Button Grid.Column="2" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" FontWeight="Bold" Height="40" Click="BtnCancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
