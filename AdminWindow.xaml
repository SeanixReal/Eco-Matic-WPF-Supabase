<Window x:Class="Eco_Matic.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Console"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5A6C84" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,15" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F2F5FB" />
                                <Setter Property="Foreground" Value="#2E77E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#2E77E6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InventoryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinWidth" Value="120" />
        </Style>

        <Style x:Key="InventoryActionButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource InventoryActionButtonStyle}">
            <Setter Property="Background" Value="#2E77E6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E68D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#10000000" BlurRadius="12" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0,16,-1"
              Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="README"
                        Style="{StaticResource TopActionTabActive}"
                        Click="OpenReadmeMenuItem_Click" />
                <Button Content="ABOUT ME"
                        Style="{StaticResource TopActionTab}"
                        Margin="0"
                        Click="AboutMenuItem_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnMinimize" Content="-" Style="{StaticResource WindowControlTab}" Click="BtnMinimize_Click" />
                <Button x:Name="btnMax" Content="o" Style="{StaticResource WindowControlTab}" Click="BtnMaximize_Click" />
                <Button x:Name="btnClose" Content="x" Style="{StaticResource WindowCloseTab}" Margin="6,0,0,0" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F7F9FC" CornerRadius="16" BorderBrush="#C5D3EB" BorderThickness="1" MouseLeftButtonDown="WindowFrame_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#2F0C264A" BlurRadius="25" ShadowDepth="6" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="White" CornerRadius="15,0,0,15" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Logo & Title -->
                        <StackPanel Grid.Row="0" Margin="20,30,20,40">
                            <TextBlock Text="Eco-Matic" FontSize="24" FontWeight="Black" Foreground="#2C3E50" />
                            <TextBlock x:Name="txtRoleLabel" Text="ADMIN ACCESS" FontSize="11" FontWeight="Bold" Foreground="#6A7891" Margin="0,5,0,0" />
                        </StackPanel>

                        <!-- Nav Buttons -->
                        <StackPanel Grid.Row="1">
                            <Button x:Name="navDashboard" Content="Dashboard" Style="{StaticResource SidebarButtonActiveStyle}" Click="Nav_Click" Tag="Dashboard" />
                            <Button x:Name="navInventory" Content="Inventory" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="Inventory" />
                            <Button x:Name="navItems" Content="Global Items" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="Items" />
                            <Button x:Name="navLogs" Content="Event Logs" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="Logs" />
                            <Button x:Name="navSales" Content="Sales Report" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="Sales" />
                            <Button x:Name="navMachines" Content="Vending Machines" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="Machines" />
                            <Button x:Name="navUsers" Content="System Admin Users" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="Users" />
                            <Button x:Name="navCustomers" Content="Customers CRM" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Click" Tag="Customers" />
                        </StackPanel>

                        <!-- Bottom Meta -->
                        <StackPanel Grid.Row="2" Margin="20,0,20,30">
                            <Button x:Name="btnLogout" Content="Logout" Style="{StaticResource SidebarButtonStyle}" Click="BtnLogout_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Column="1" Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtViewTitle" Text="Project Dashboard" FontSize="28" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Content Grids -->
                    <Grid Grid.Row="1">
                        
                        <!-- Dashboard View -->
                        <Grid x:Name="viewDashboard" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <UniformGrid Grid.Row="0" Columns="4" Rows="1" Margin="0,0,0,20">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL SALES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10" />
                                        <TextBlock x:Name="txtTotalSales" Text="₱0.00" FontSize="28" FontWeight="Black" Foreground="#1E293B" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="ITEMS SOLD" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10" />
                                        <TextBlock x:Name="txtItemsSold" Text="0" FontSize="28" FontWeight="Black" Foreground="#1E293B" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="LOW STOCK ALERTS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10" />
                                        <TextBlock x:Name="txtLowStock" Text="0" FontSize="28" FontWeight="Black" Foreground="#D65A5A" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE MACHINES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10" />
                                        <TextBlock x:Name="txtActiveMachines" Text="0" FontSize="28" FontWeight="Black" Foreground="#1E293B" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Sales Report Report (Year)" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />
                                        <ItemsControl x:Name="icDashboardSalesTrend" Grid.Row="1">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="84"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="12" Background="#EAF1FB" CornerRadius="6" VerticalAlignment="Center">
                                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="#2E77E6" CornerRadius="6"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#1E293B" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="10,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Stock Monitoring" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />
                                        <DataGrid x:Name="dgDashboardLowStock" Grid.Row="1" MinHeight="118" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Machine" Binding="{Binding Path='Machine'}" Width="130"/>
                                                <DataGridTextColumn Header="Item" Binding="{Binding Path='Item'}" Width="*"/>
                                                <DataGridTextColumn Header="Stock" Binding="{Binding Path='Stock'}" Width="55"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Path='Status'}" Width="95"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Recent Activity" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15" />
                                    <DataGrid x:Name="dgRecentActivity" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Date" Binding="{Binding Path='Timestamp', StringFormat='{}{0:MM/dd/yyyy HH:mm:ss}'}" Width="150"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Path='Event'}" Width="120"/>
                                            <DataGridTextColumn Header="Details" Binding="{Binding Path='Notes'}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Inventory View Placeholder -->
                        <Grid x:Name="viewInventory" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Select Vending Machine:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <ComboBox x:Name="cboInventoryMachine" Width="250" SelectionChanged="CboInventoryMachine_SelectionChanged" DisplayMemberPath="location_name" SelectedValuePath="machine_id"/>
                            </StackPanel>
                            
                            <WrapPanel Grid.Row="1" Margin="0,0,0,15" Orientation="Horizontal">
                                <Button Content="Assign Item to Slot" Width="170" Margin="0,0,10,10" Style="{StaticResource InventoryActionButtonActiveStyle}" Click="BtnAddItem_Click"/>
                                <Button Content="Restock Item" Width="135" Margin="0,0,10,10" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnRestock_Click"/>
                                <Button Content="Restock Selected to Max" Width="190" Margin="0,0,10,10" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnRestockSelectedToMax_Click"/>
                                <Button Content="Edit Slot" Width="125" Margin="0,0,10,10" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnEditItem_Click"/>
                                <Button Content="Remove From Slot" Width="170" Margin="0,0,0,10" Background="#FCE7E7" Foreground="#D65A5A" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnDeleteItem_Click"/>
                            </WrapPanel>

                            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="Transparent">
                                <DataGrid x:Name="dgInventory" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0" RowHeight="60">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="60"/>
                                        <DataGridTemplateColumn Header="Image" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Image, Converter={StaticResource ImagePathConverter}}" Width="50" Height="50" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding Item}" Width="*"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                                        <DataGridTextColumn Header="Default Price (₱)" Binding="{Binding Path='Default Price', StringFormat={}{0:F2}}" Width="110"/>
                                        <DataGridTextColumn Header="Slot Price (₱)" Binding="{Binding Path='Slot Price', StringFormat={}{0:F2}}" Width="100"/>
                                        <DataGridTextColumn Header="Effective Price (₱)" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="110"/>
                                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                    <Setter Property="Margin" Value="5,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                            <Setter Property="Foreground" Value="#D65A5A"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Stock}" Value="1">
                                                            <Setter Property="Foreground" Value="#D65A5A"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Stock}" Value="2">
                                                            <Setter Property="Foreground" Value="#D65A5A"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Stock}" Value="3">
                                                            <Setter Property="Foreground" Value="#D65A5A"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Max Cap" Binding="{Binding Max Capacity}" Width="80"/>
                                        <DataGridTextColumn Header="Dispense Message" Binding="{Binding Path='Dispense Message'}" Width="*"/>
                                        <DataGridTextColumn Header="Examine Message" Binding="{Binding Path='Examine Message'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- Global Items View -->
                        <Grid x:Name="viewItems" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Global Item Catalog" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Content="Add Global Item" Width="170" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonActiveStyle}" Click="BtnAddCatalogItem_Click"/>
                                    <Button Content="Edit Global Item" Width="170" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnEditCatalogItem_Click"/>
                                    <Button Content="Delete Global Item" Width="180" Background="#FCE7E7" Foreground="#D65A5A" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnDeleteCatalogItem_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="White" Margin="0,0,0,20">
                                <DataGrid x:Name="dgItems" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0" RowHeight="60">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                                        <DataGridTemplateColumn Header="Image" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Image, Converter={StaticResource ImagePathConverter}}" Width="50" Height="50" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                                        <DataGridTextColumn Header="Default Price (₱)" Binding="{Binding Path='Default Price', StringFormat={}{0:F2}}" Width="120"/>
                                        <DataGridTextColumn Header="Calories" Binding="{Binding Calories}" Width="80"/>
                                        <DataGridTextColumn Header="Machines Using Item" Binding="{Binding Path='Machines Using Item'}" Width="120"/>
                                        <DataGridTextColumn Header="Dispense Message" Binding="{Binding Path='Dispense Message'}" Width="*"/>
                                        <DataGridTextColumn Header="Examine Message" Binding="{Binding Path='Examine Message'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Recycle Catalog" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Content="Add Recycle Item" Width="170" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonActiveStyle}" Click="BtnAddRecycleItem_Click"/>
                                    <Button Content="Edit Recycle Item" Width="170" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnEditRecycleItem_Click"/>
                                    <Button Content="Toggle Active" Width="150" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnToggleRecycleItem_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="White">
                                <DataGrid x:Name="dgRecycleItems" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Path='ID'}" Width="60"/>
                                        <DataGridTextColumn Header="Display Name" Binding="{Binding Path='Display Name'}" Width="180"/>
                                        <DataGridTextColumn Header="Material Type" Binding="{Binding Path='Material Type'}" Width="140"/>
                                        <DataGridTextColumn Header="Unit" Binding="{Binding Path='Unit Label'}" Width="90"/>
                                        <DataGridTextColumn Header="Points / Unit" Binding="{Binding Path='Points / Unit'}" Width="100"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Path='Active'}" Width="90"/>
                                        <DataGridTextColumn Header="Sort" Binding="{Binding Path='Sort Order'}" Width="70"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Path='Description'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- Logs View -->
                        <Grid x:Name="viewLogs" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Clear Logs" Width="130" HorizontalAlignment="Left" Style="{StaticResource InventoryActionButtonStyle}" Background="#FCE7E7" Foreground="#D65A5A" Click="BtnClearLogs_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Filter By:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B" FontWeight="Bold"/>
                                    <ComboBox x:Name="cboLogsFilter" Width="100" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="LogsFilter_Changed" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Day"/>
                                        <ComboBoxItem Content="Week"/>
                                        <ComboBoxItem Content="Month"/>
                                        <ComboBoxItem Content="Year"/>
                                        <ComboBoxItem Content="All Time"/>
                                    </ComboBox>
                                    <DatePicker x:Name="dpLogsDate" Width="130" SelectedDateChanged="LogsFilter_Changed" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="White">
                                <DataGrid x:Name="dgLogs" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Log ID" Binding="{Binding Path='Log ID'}" Width="80"/>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Path='Timestamp'}" Width="180"/>
                                        <DataGridTextColumn Header="Event" Binding="{Binding Path='Event'}" Width="100"/>
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Path='Notes'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- Sales View -->
                        <Grid x:Name="viewSales" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="8,4,12,12">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="txtSalesFilterLabel" Text="Sales (Today)" Foreground="#64748B" FontSize="13" FontWeight="Medium"/>
                                                    <TextBlock x:Name="txtSalesTotal" Text="₱ 0.00" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="TRANSACTIONS" Foreground="#64748B" FontSize="13" FontWeight="Medium"/>
                                                    <TextBlock x:Name="txtSalesTransactions" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="AVG SALE" Foreground="#64748B" FontSize="13" FontWeight="Medium"/>
                                                    <TextBlock x:Name="txtSalesAverage" Text="₱ 0.00" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="BEST ITEM" Foreground="#64748B" FontSize="13" FontWeight="Medium"/>
                                                    <TextBlock x:Name="txtSalesBestItem" Text="-" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0">
                                            <TextBlock Text="Machine:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B" FontWeight="Bold"/>
                                            <ComboBox x:Name="cboSalesMachine" Width="190" Margin="0,0,14,8" SelectionChanged="SalesFilter_Changed" DisplayMemberPath="location_name" SelectedValuePath="machine_id" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="Filter By:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B" FontWeight="Bold"/>
                                            <ComboBox x:Name="cboSalesFilter" Width="105" Margin="0,0,10,8" SelectedIndex="0" SelectionChanged="SalesFilter_Changed" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="Day"/>
                                                <ComboBoxItem Content="Week"/>
                                                <ComboBoxItem Content="Month"/>
                                                <ComboBoxItem Content="Year"/>
                                                <ComboBoxItem Content="All Time"/>
                                            </ComboBox>
                                            <DatePicker x:Name="dpSalesDate" Width="130" Margin="0,0,0,8" SelectedDateChanged="SalesFilter_Changed" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Revenue Trend" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                                <ItemsControl x:Name="icSalesTrend">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,9">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1" Height="14" Background="#EAF1FB" CornerRadius="7" VerticalAlignment="Center">
                                                                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{Binding Fill}" CornerRadius="7"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#1E293B" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Product Mix" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                                <Canvas x:Name="canvasSalesPie" Grid.Row="1" Width="170" Height="170" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                <ItemsControl x:Name="icSalesPieLegend" Grid.Row="2">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                                <Border Width="10" Height="10" Background="{Binding Fill}" CornerRadius="5" Margin="0,4,7,0"/>
                                                                <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12" Width="120" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ValueText}" Foreground="#1E293B" FontSize="12" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Best-Selling Items" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                                <ItemsControl x:Name="icTopItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,9">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1" Height="14" Background="#EAF1FB" CornerRadius="7" VerticalAlignment="Center">
                                                                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="#2FA66A" CornerRadius="7"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#1E293B" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Machine Revenue" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                                <ItemsControl x:Name="icMachineRevenue">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,9">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1" Height="14" Background="#EAF1FB" CornerRadius="7" VerticalAlignment="Center">
                                                                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="#FFCE4A" CornerRadius="7"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#1E293B" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="260"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Transaction Details" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                            <DataGrid x:Name="dgSales" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="TX ID" Binding="{Binding Path='TX ID'}" Width="60"/>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding Path='Date'}" Width="150"/>
                                                    <DataGridTextColumn Header="Machine" Binding="{Binding Path='Machine'}" Width="150"/>
                                                    <DataGridTextColumn Header="Item" Binding="{Binding Path='Item'}" Width="120"/>
                                                    <DataGridTextColumn Header="Qty" Binding="{Binding Path='Quantity'}" Width="40"/>
                                                    <DataGridTextColumn Header="Price" Binding="{Binding Path='Price', StringFormat='₱{0:N2}'}" Width="80"/>
                                                    <DataGridTextColumn Header="Total Paid" Binding="{Binding Path='Total Paid', StringFormat='₱{0:N2}'}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Machines View -->
                        <Grid x:Name="viewMachines" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="btnAddMachine" Content="Register Machine" Width="170" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonActiveStyle}" Click="BtnAddMachine_Click"/>
                                <Button Content="Edit Machine" Width="160" Margin="0,0,10,0" Background="#F2F5FB" Foreground="#2E77E6" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnEditMachine_Click"/>
                                <Button Content="Remove Machine" Width="170" Margin="0,0,0,0" Background="#FCE7E7" Foreground="#D65A5A" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnDeleteMachine_Click"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="14,0,0,0">
                                    <TextBlock x:Name="txtMachineScope" Text="0 / 4 machines in use" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>

                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="White">
                                <DataGrid x:Name="dgMachines" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding [ID]}" Width="70"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding [Name]}" Width="170"/>
                                        <DataGridTextColumn Header="Address" Binding="{Binding [Address]}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding [Status]}" Width="120"/>
                                        <DataGridTextColumn Header="Deployed" Binding="{Binding [Deployed], StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- Users View -->
                        <Grid x:Name="viewUsers" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Button Content="Add New Staff" Width="160" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonActiveStyle}" Click="BtnAddUser_Click"/>
                                <Button Content="Edit Assignments" Width="180" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnEditUserAssignments_Click"/>
                                <Button Content="Remove Staff" Width="160" Margin="0,0,0,0" Background="#FCE7E7" Foreground="#D65A5A" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnDeleteUser_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="White">
                                <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding [ID]}" Width="70"/>
                                        <DataGridTextColumn Header="Username" Binding="{Binding [Username]}" Width="160"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding [Role]}" Width="160"/>
                                        <DataGridTextColumn Header="Assigned Machines" Binding="{Binding [Assigned Machines]}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- Customers View -->
                        <Grid x:Name="viewCustomers" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Button Content="Modify Eco-Credit Balance" Width="240" Margin="0,0,10,0" Style="{StaticResource InventoryActionButtonActiveStyle}" Click="BtnEditCustomerCredits_Click"/>
                                <Button Content="Delete Customer" Width="170" Margin="0,0,0,0" Background="#FCE7E7" Foreground="#D65A5A" Style="{StaticResource InventoryActionButtonStyle}" Click="BtnDeleteCustomer_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" BorderThickness="0" Background="White">
                                <DataGrid x:Name="dgCustomers" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
