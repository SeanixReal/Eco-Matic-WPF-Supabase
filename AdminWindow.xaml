<Window x:Class="Eco_Matic.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic - Admin"
        Height="900"
        Width="1280"
        MinHeight="790"
        MinWidth="1140"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DFEC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="AdminPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E77E6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2E77E6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="AdminSuccessButton" TargetType="Button" BasedOn="{StaticResource AdminPrimaryButton}">
            <Setter Property="Background" Value="#2FA66A" />
            <Setter Property="BorderBrush" Value="#2FA66A" />
        </Style>

        <Style x:Key="AdminDangerButton" TargetType="Button" BasedOn="{StaticResource AdminPrimaryButton}">
            <Setter Property="Background" Value="#D65A5A" />
            <Setter Property="BorderBrush" Value="#D65A5A" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Admin Console"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#2E77E6" />
            <TextBlock Text="Inventory control, item management, and event monitoring"
                       Foreground="#6A7891"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource CardBorderStyle}">
            <Border.Effect>
                <DropShadowEffect Color="#10000000" BlurRadius="14" ShadowDepth="3" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Current Inventory"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#2C3F60" />
            <DataGrid x:Name="inventoryGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      Background="#FCFDFF"
                      Foreground="#22324D"
                      BorderBrush="#D7DFEC"
                      BorderThickness="1"
                      LoadingRow="InventoryGrid_LoadingRow"
                      SelectionChanged="InventoryGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=PHP {0:F2}}" Width="130" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="95" />
                    <DataGridTextColumn Header="Flavor / Description" Binding="{Binding FlavorText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                    <GroupBox Header="Restock" Width="370" Margin="0,0,12,12">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Select item" />
                                <ComboBox x:Name="cboItem" Margin="0,4,0,8" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Quantity to add" />
                                <TextBox x:Name="txtRestockQty" Margin="0,4,0,8" Text="1" />
                            </StackPanel>

                            <UniformGrid Grid.Row="2" Columns="2">
                                <Button x:Name="btnUpdate"
                                        Margin="0,0,6,0"
                                        Height="34"
                                        Content="Restock to Max"
                                        Style="{StaticResource AdminSuccessButton}"
                                        Click="BtnUpdate_Click" />
                                <Button x:Name="btnRestockAdd"
                                        Margin="6,0,0,0"
                                        Height="34"
                                        Content="Add Quantity"
                                        Style="{StaticResource AdminPrimaryButton}"
                                        Click="BtnRestockAdd_Click" />
                            </UniformGrid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Remove Item" Width="370" Margin="0,0,12,12">
                        <StackPanel Margin="10">
                            <TextBlock Text="Select item" />
                            <ComboBox x:Name="cboRemoveItem" Margin="0,4,0,10" />
                            <Button x:Name="btnRemoveItem"
                                    Height="34"
                                    Content="Remove Item"
                                    Style="{StaticResource AdminDangerButton}"
                                    Click="BtnRemoveItem_Click" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Log Tools" Width="420" Margin="0,0,0,12">
                        <StackPanel Margin="10">
                            <Button x:Name="btnViewLog"
                                    Height="34"
                                    Margin="0,0,0,8"
                                    Content="View Event Log"
                                    Style="{StaticResource AdminPrimaryButton}"
                                    Click="BtnViewLog_Click" />
                            <Button x:Name="btnClearLog"
                                    Height="34"
                                    Margin="0,0,0,8"
                                    Content="Clear Event Log"
                                    Style="{StaticResource AdminDangerButton}"
                                    Click="BtnClearLog_Click" />
                            <Button x:Name="btnOpenReadme"
                                    Height="34"
                                    Content="Open README"
                                    Style="{StaticResource {x:Type Button}}"
                                    Click="BtnOpenReadme_Click" />
                        </StackPanel>
                    </GroupBox>
                </WrapPanel>

                <GroupBox Header="Add Item">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,8,4" Text="Type" />
                        <ComboBox x:Name="cboAddType"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="0,2,12,6"
                                  SelectionChanged="CboAddType_SelectedIndexChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,8,4" Text="Name" />
                        <TextBox x:Name="txtAddName" Grid.Row="1" Grid.Column="1" Margin="0,2,12,6" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,8,4" Text="Price (PHP)" />
                        <TextBox x:Name="txtAddPrice" Grid.Row="2" Grid.Column="1" Margin="0,2,12,6" Text="1" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,8,4" Text="Stock" />
                        <TextBox x:Name="txtAddStock" Grid.Row="3" Grid.Column="1" Margin="0,2,12,6" Text="15" />

                        <TextBlock x:Name="lblAddCalories" Grid.Row="4" Grid.Column="0" Margin="0,4,8,4" Text="Calories" />
                        <TextBox x:Name="txtAddCalories" Grid.Row="4" Grid.Column="1" Margin="0,2,12,6" Text="0" />

                        <TextBlock x:Name="lblAddVolume" Grid.Row="5" Grid.Column="0" Margin="0,4,8,4" Text="Volume (ml)" />
                        <TextBox x:Name="txtAddVolume" Grid.Row="5" Grid.Column="1" Margin="0,2,12,6" Text="0" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4,8,4" Text="Flavor / Description" />
                        <TextBox x:Name="txtAddFlavor"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Margin="0,2,12,6"
                                 Height="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,2,12,6">
                            <Button x:Name="btnBrowseImage"
                                    Width="120"
                                    Height="30"
                                    Margin="0,0,10,0"
                                    Content="Browse Image"
                                    Click="BtnBrowseImage_Click" />
                            <TextBlock x:Name="lblImagePath" VerticalAlignment="Center" Text="No image selected" />
                        </StackPanel>

                        <Button x:Name="btnAddItem"
                                Grid.Row="8"
                                Grid.Column="1"
                                Height="36"
                                Margin="0,8,12,0"
                                Content="Add Item"
                            Style="{StaticResource AdminSuccessButton}"
                                Click="BtnAddItem_Click" />

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Grid.RowSpan="9"
                                Margin="6,2,0,0"
                            Background="#F8FAFD"
                            BorderBrush="#D7DFEC"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="Image Preview" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Image x:Name="picImagePreview" Height="210" Stretch="Uniform" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Admin Help"
                    Width="120"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource {x:Type Button}}"
                    Click="BtnAdminHelp_Click" />
            <Button Content="Back"
                    Width="120"
                    Height="34"
                    Background="#2E77E6"
                    Foreground="White"
                    BorderBrush="#2E77E6"
                    BorderThickness="0"
                    Click="BtnBack_Click" />
        </StackPanel>
    </Grid>
</Window>
