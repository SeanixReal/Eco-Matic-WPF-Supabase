<Window x:Class="Eco_Matic.CustomerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic eWallet" Height="450" Width="600" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Customer Dashboard" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock x:Name="txtWelcome" Text="Welcome, User" FontSize="14" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#2FA66A" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Eco-Credit Balance" Foreground="#D1FAE5" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtBalance" Text="0" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#E2E8F0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Recent Activity" FontWeight="SemiBold" FontSize="16" Foreground="#475569" Margin="0,0,0,10"/>
                
                <TextBlock Grid.Row="1" Text="No transactions yet. Start recycling to earn credits!" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
               
                <!-- We can replace the TextBlock above with a DataGrid later when specific customer historical tables are added to the DB -->
            </Grid>
        </Border>

        <Button x:Name="btnClose" Grid.Row="3" Content="Log Out / Close" Padding="10" Margin="0,20,0,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" Click="BtnClose_Click"/>
    </Grid>
</Window>
