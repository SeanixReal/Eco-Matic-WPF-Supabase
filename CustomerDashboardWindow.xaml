<Window x:Class="Eco_Matic.CustomerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eco-Matic | Customer Dashboard"
        Height="560"
        Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title and User Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Customer Dashboard"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
            <TextBlock x:Name="txtWelcome"
                       Text="Welcome, User"
                       FontSize="15"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Balance Card -->
        <Border Grid.Row="1"
                Background="#2FA66A"
                CornerRadius="12"
                Padding="30"
                Margin="0,0,0,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#2FA66A" Opacity="0.2" ShadowDepth="5" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Eco-Credit Balance"
                           Foreground="#D1FAE5"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Opacity="0.9"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="txtBalance"
                               Text="0"
                               Foreground="White"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text=" pts"
                               Foreground="#D1FAE5"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Bottom"
                               Margin="4,0,0,10"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Transaction History"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,10"/>
                <DataGrid x:Name="dgAccountHistory"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Path='Timestamp', StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="140"/>
                        <DataGridTextColumn Header="Item" Binding="{Binding Path='Item'}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Path='Quantity'}" Width="60"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding Path='Paid'}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Actions -->
        <Button x:Name="btnClose"
                Grid.Row="3"
                Content="Log Out / Close"
                Height="45"
                Padding="20,0"
                Cursor="Hand"
                Background="#FFFFFF"
                Foreground="#475569"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FontWeight="SemiBold"
                Click="BtnClose_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
