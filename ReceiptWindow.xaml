<Window x:Class="Eco_Matic.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt"
        Height="560"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid>
        <!-- Custom Window Controls Tab -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Margin="0,0,30,0">
            <Button Content="-" Width="40" Height="28" Margin="0,0,5,0" Style="{StaticResource WindowControlTab}" Click="BtnMinimize_Click"/>
            <Button Content="o" Width="40" Height="28" Margin="0,0,5,0" Style="{StaticResource WindowControlTab}" Click="BtnMaximize_Click"/>
            <Button Content="x" Width="40" Height="28" Style="{StaticResource WindowCloseTab}" Click="BtnClose_Click" />
        </StackPanel>
        
        <!-- Main Card Border -->
        <Border Background="White" CornerRadius="12" Margin="0,30,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.1" />
            </Border.Effect>
            <Grid Margin="14">
                    <Border Background="White"
                            BorderBrush="#D7DFEC"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#14000000" BlurRadius="18" ShadowDepth="4" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="Eco-Matic Receipt"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           Foreground="#2E77E6"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Thank you for using Eco-Matic"
                                           Foreground="#6A7891"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="lblReceiptMeta"
                                           Foreground="#6A7891"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="lblPrintStatus"
                                           Foreground="#4B5B75"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           Text="Printer status unavailable." />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,0,0,12"
                                    Background="#F7FAFF"
                                    BorderBrush="#DDE5F2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="lblMachineName"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#2E77E6"
                                               Text="Machine: -" />
                                    <TextBlock x:Name="lblMachineAddress"
                                               Margin="0,4,0,0"
                                               Foreground="#52637F"
                                               TextWrapping="Wrap"
                                               Text="Address: -" />
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="itemsList"
                                     Grid.Row="2"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Background="#F9FBFF"
                                     BorderBrush="#D7DFEC"
                                     BorderThickness="1"
                                     Padding="6" />

                            <Border Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Background="#F7FAFF"
                                    BorderBrush="#DDE5F2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="lblTotal" FontFamily="Consolas" FontSize="14" Text="Total:  PHP 0.00" />
                                    <TextBlock x:Name="lblPaid" FontFamily="Consolas" FontSize="14" Text="Paid:   PHP 0.00" />
                                    <TextBlock x:Name="lblChange" FontFamily="Consolas" FontSize="14" Text="Change: PHP 0.00" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,14,0,0">
                                <Button x:Name="btnPrint"
                                        Height="36"
                                        Width="130"
                                        Margin="0,0,10,0"
                                        Content="Print"
                                        Background="#1B9C67"
                                        Foreground="White"
                                        BorderBrush="#1B9C67"
                                        BorderThickness="0"
                                        Click="BtnPrint_Click" />
                                <Button Height="36"
                                        Width="130"
                                        Content="Close"
                                        Background="#2E77E6"
                                        Foreground="White"
                                        BorderBrush="#2E77E6"
                                        BorderThickness="0"
                                        Click="BtnClose_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
        </Border>
    </Grid>
</Window>
